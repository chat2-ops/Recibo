function exportProductsCSV(){const rows=[['Produto','Categoria','Estoque','Custo por unidade','Preço de venda','Lucro bruto por unidade'],...state.products.map(p=>[p.name,p.category,p.stock,p.cost,p.price,Math.round((p.price-p.cost)*100)/100])];const csv=rows.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(';')).join('\r\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='estoque-vendafacil.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1500);toast('Lista de produtos exportada em CSV.')}
function exportProductsPDF(){const rows=[...state.products].sort((a,b)=>a.name.localeCompare(b.name,'pt-BR')),units=rows.reduce((a,p)=>a+p.stock,0),cost=rows.reduce((a,p)=>a+p.stock*p.cost,0),sale=rows.reduce((a,p)=>a+p.stock*p.price,0),date=new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short'}).format(new Date()),report=$('#pdf-stock-report');report.innerHTML=`<article class="pdf-stock-sheet"><header class="pdf-stock-head"><div><small>VENDAFÁCIL</small><h1>Relatório de estoque</h1><p>Inventário de celulares e acessórios</p></div><div class="pdf-stock-date">Gerado em<br><strong>${esc(date)}</strong></div></header><section class="pdf-stock-summary"><div><small>Produtos cadastrados</small><strong>${rows.length}</strong></div><div><small>Unidades em estoque</small><strong>${units}</strong></div><div><small>Custo total do estoque</small><strong>${money(cost)}</strong></div><div><small>Valor previsto de venda</small><strong>${money(sale)}</strong></div></section><table class="pdf-stock-table"><thead><tr><th>Produto</th><th>Categoria</th><th>Estoque</th><th>Custo un.</th><th>Venda un.</th><th>Lucro bruto un.</th><th>Custo total</th></tr></thead><tbody>${rows.length?rows.map(p=>`<tr><td>${esc(p.name)}</td><td>${esc(p.category)}</td><td>${p.stock} un.</td><td>${money(p.cost)}</td><td>${money(p.price)}</td><td>${money(p.price-p.cost)}</td><td>${money(p.stock*p.cost)}</td></tr>`).join(''):'<tr><td colspan="7" class="pdf-empty">Nenhum produto cadastrado.</td></tr>'}</tbody>${rows.length?`<tfoot><tr><th colspan="2">Total</th><th>${units} un.</th><th colspan="3"></th><th>${money(cost)}</th></tr></tfoot>`:''}</table><footer class="pdf-stock-foot">Relatório gerado pelo VendaFácil. Lucro bruto não desconta taxas, impostos ou despesas.</footer></article>`;const oldTitle=document.title;const restore=()=>{document.body.classList.remove('printing-stock');document.title=oldTitle;report.innerHTML='';window.removeEventListener('afterprint',restore)};document.body.classList