function bindPage(){document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>setPage(b.dataset.go));document.querySelectorAll('[data-receipt]').forEach(b=>b.onclick=()=>setPage('receipt',b.dataset.receipt));document.querySelectorAll('[data-edit-sale]').forEach(b=>b.onclick=()=>beginEditSale(b.dataset.editSale));document.querySelectorAll('[data-delete-sale]').forEach(b=>b.onclick=()=>deleteSale(b.dataset.deleteSale));const pf=document.querySelector('#product-form');if(pf)pf.onsubmit=addProduct;const cancel=document.querySelector('#product-cancel');if(cancel)cancel.onclick=cancelProductEdit;const cancelSale=document.querySelector('[data-cancel-sale-edit]');if(cancelSale)cancelSale.onclick=()=>setPage('receipt',receiptId);const sf=document.querySelector('#sale-form');if(sf){sf.querySelector('[name=productId]').onchange=()=>{const p=state.products.find(x=>x.id===sf.elements.namedItem('productId').value);if(p)sf.elements.namedItem('unitPrice').value=p.price;previewSale()};['quantity','unitPrice','n','rate','firstDue'].forEach(name=>sf.elements.namedItem(name).addEventListener('input',previewSale));previewSale();sf.onsubmit=page==='edit-sale'?updateSale:addSale;}document.querySelectorAll('[data-toggle-paid]').forEach(b=>b.onclick=()=>togglePaid(b.dataset.togglePaid,Number(b.dataset.index)));const pr=document.querySelector('[data-print]');if(pr)pr.onclick=()=>window.print();document.querySelectorAll('[data-share]').forEach(b=>b.onclick=()=>shareReceipt(b.dataset.share));const ex=document.querySelector('[data-export]');if(ex)ex.onclick=exportBackup;if(page==='products'){renderProductTable();const exportBtn=$('[data-export-products]');if(exportBtn)exportBtn.onclick=exportProductsCSV;const pdfBtn=$('[data-export-products-pdf]');if(pdfBtn)pdfBtn.onclick=exportProductsPDF}if(page==='sales'){const input=$('#sales-search');if(input)input.oninput=()=>{const q=input.value.trim().toLocaleLowerCase('pt-BR');let shown=0;document.querySelectorAll('.sales-contract').forEach(row=>{const match=(row.dataset.search||'').includes(q);row.classList.toggle('hidden',!match);if(match)shown++});const count=$('#sales-count');if(count)count.textContent=String(shown)}}}
function productKey(p){const norm=v=>String(v||'').trim().toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g,'');return `${norm(p.name)}::${norm(p.category)}`}
function duplicateGroups(){const map=new Map();state.products.forEach(p=>{const k=productKey(p);if(!map.has(k))map.set(k,[]);map.get(k).push(p)});return [...map.values()].filter(group=>group.length>1)}
function consolidateProductRecords(matches,incoming=null){const primary=matches[0],ids=new Set(matches.map(p=>p.id));const oldStock=matches.reduce((a,p)=>a+p.stock,0),incomingStock=incoming?incoming.stock:0,totalStock=oldStock+incomingStock;const inventoryValue=matches.reduce((a,p)=>a+p.stock*p.cost,0)+(incoming?incoming.stock*incoming.cost:0);const latest=matches[matches.length-1];primary.name=incoming?incoming.name:latest.name;primary.category=incoming?incoming.category:latest.category;primary.stock=totalStock;primary.cost=totalStock?Math.round(inventoryValue/totalStock*100)/100:(incoming?incoming.cost:latest.cost);primary.price=incoming?incoming.price:latest.price;state.products=state.products.filter(p=>!ids.has(p.id)||p.id===primary.id);state.sales.forEach(s=>{if(ids.has(s.productId))s.productId=primary.id});return primary}
function addProduct(e){e.preventDefault();const f=e.currentTarget;const data={name:f.elements.namedItem('name').value.trim(),category:f.elements.namedItem('category').value,stock:Math.max(0,parseInt(f.elements.namedItem('stock').value)||0),cost:Number(f.elements.namedItem('cost').value),price:Number(f.elements.namedItem('price').value)};if(!data.name||data.cost<0||data.price<=0){toast('Confira o nome e os valores do produto.');return}if(editingProductId){const existing=state.products.find(x=>x.id===editingProductId);if(!existing){toast('Esse item não foi encontrado.');cancelProductEdit();return}Object.assign(existing,data);editingProductId=null;persist();toast('Item atualizado.');render()}else{const matches=state.products.filter(p=>productKey(p)===productKey(data));if(matches.length){const existingStock=matches.reduce((a,p)=>a+p.stock,0),incomingStock=data.stock,total=existingStock+incomingStock;const inventoryValue=matches.reduce((a,p)=>a+p.stock*p.cost,0)+incomingStock*data.cost;const avg=total?Math.round(inventoryValue/total*100)/100:data.cost;const detail=matches.length>1?` Vou unir também os ${matches.length} cadastros repetidos.`:'';if(!confirm(`Já existe “${data.name}” na categoria ${data.category}.${detail} Estoque: ${existingStock} + ${incomingStock} = ${total} unidades. O custo médio ficará ${money(avg)} e o preço de venda será atualizado para ${money(data.price)}. Confirmar?`))return;consolidateProductRecords(matches,data);persist();toast('Estoque atualizado no cadastro existente.')}else{state.products.push({id:newId(),...data});persist();toast('Produto salvo no estoque.')}render()}}
function editProduct(id){const p=state.products.find(x=>x.id===id);const f=document.querySelector('#product-form');if(!p||!f)return;editingProductId=id;f.elements.namedItem('name').value=p.name;f.elements.namedItem('category').value=p.category;f.elements.namedItem('stock').value=p.stock;f.elements.namedItem('cost').value=p.cost;f.elements.namedItem('price').value=p.price;document.querySelector('#product-form-title').textContent='Editar produto';document.querySelector('#product-submit').textContent='Salvar alterações';document.querySelector('#product-cancel').classList.remove('hidden');f.scrollIntoView({behavior:'smooth',block:'center'})}
function cancelProductEdit(){editingProductId=null;const f=document.querySelector('#product-form');if(f)f.reset();const title=document.querySelector('#product-form-title');if(title)title.textContent='Novo produto';const submit=document.querySelector('#product-submit');if(submit)submit.textContent='＋ Salvar produto';const cancel=document.querySelector('#product-cancel');if(cancel)cancel.classList.add('hidden')}
function mergeProductGroup(ids){const group=state.products.filter(p=>ids.includes(p.id));if(group.length<2)return;const units=group.reduce((a,p)=>a+p.stock,0),value=group.reduce((a,p)=>a+p.stock*p.cost,0),avg=units?Math.round(value/units*100)/100:group[group.length-1].cost;const price=group[group.length-1].price;if(!confirm(`Unir ${group.length} registros de “${group[0].name}”? O estoque ficará em ${units} unidades, o custo será a média ponderada (${money(avg)}) e será mantido o preço de venda do cadastro mais recente (${money(price)}).`))return;consolidateProductRecords(group);persist();renderProductTable();toast('Cadastros unidos em um único item.')}
function renderProductTable(){const totalCost=state.products.reduce((a,p)=>a+p.stock*p.cost,0),totalRetail=state.products.reduce((a,p)=>a+p.stock*p.price,0),units=state.products.reduce((a,p)=>a+p.stock,0);const sm=document.querySelector('#stock-summary');if(sm){const avgCost=units?totalCost/units:0,avgRetail=units?totalRetail/units:0;sm.innerHTML=`<div class="row"><span class="muted">Unidades em estoque</span><strong>${units}</strong></div><div class="row"><span class="muted">Custo médio por unidade</span><strong>${money(avgCost)}</strong></div><div class="row"><span class="muted">Preço médio de venda por unidade</span><strong>${money(avgRetail)}</strong></div><div class="row"><span class="muted">Lucro bruto médio por unidade</span><strong>${money(avgRetail-avgCost)}</strong></div><div class="row"><span class="muted">Custo total do estoque</span><strong>${money(totalCost)}</strong></div><div class="row"><span class="muted">Venda prevista do estoque todo</span><strong>${money(totalRetail)}</strong></div><div class="help">Valores médios por unidade; lucro bruto não desconta taxas, impostos ou despesas.</div>`}const table=$('#product-table');if(!table)return;const alert=$('#duplicate-alert');if(alert){const groups=duplicateGroups();alert.innerHTML=groups.map(group=>`<div class="block-note"><strong>Cadastro repetido:</strong> ${esc(group[0].name)} (${esc(group[0].category)}) aparece ${group.length} vezes. Estoque e custo podem ser consolidados num item. <button class="btn small secondary" data-merge-products="${group.map(p=>p.id).join(',')}">Unir cadastros</button></div>`).join('');alert.querySelectorAll('[data-merge-products]').forEach(b=>b.onclick=()=>mergeProductGroup(b.dataset.mergeProducts.split(',')))}const search=$('#product-search'),query=(search?.value||'').trim().toLocaleLowerCase('pt-BR');if(search)search.oninput=()=>renderProductTable();if(!state.products.length){table.innerHTML='<div class="empty">Nenhum produto cadastrado.</div>';return}const shown=state.p