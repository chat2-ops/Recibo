function applyTheme(theme,save=true){const dark=theme==='dark';document.documentElement.dataset.theme=dark?'dark':'light';const btn=$('#theme-toggle');if(btn){btn.innerHTML=dark?'<span class="theme-toggle-icon" aria-hidden="true">☀</span><span class="theme-toggle-label">Modo claro</span>':'<span class="theme-toggle-icon" aria-hidden="true">☾</span><span class="theme-toggle-label">Modo escuro</span>';btn.setAttribute('aria-label',dark?'Ativar modo claro':'Ativar modo escuro')}const meta=document.querySelector('meta[name="theme-color"]');if(meta)meta.content=dark?'#091321':'#142641';if(save)try{localStorage.setItem(THEME_KEY,dark?'dark':'light')}catch(e){}}
let savedTheme='light';try{savedTheme=localStorage.getItem(THEME_KEY)==='dark'?'dark':'light'}catch(e){}applyTheme(savedTheme,false);
function setSync(t){const el=$('#sync-status');if(el)el.textContent=t}
function snapshot(){synced={products:new Map(state.products.map(x=>[x.id,JSON.stringify(x)])),sales:new Map(state.sales.map(x=>[x.id,JSON.stringify(x)])),rentals:new Map(R().map(x=>[x.id,JSON.stringify(x)]))}}
function diffOf(list,map){const cur=new Map(list.map(x=>[x.id,JSON.stringify(x)]));return{cur,up:list.filter(x=>map.get(x.id)!==cur.get(x.id)),del:[...map.keys()].filter(id=>!cur.has(id))}}
function pending(){const a=diffOf(state.products,synced.products),b=diffOf(state.sales,synced.sales),c=diffOf(R(),synced.rentals);return a.up.length+a.del.length+b.up.length+b.del.length+c.up.length+c.del.length}
function status(){if(!session)return;const n=pending(),on=navigator.onLine&&!offlineMode;setSync(n?(on?`Enviando ${n}…`:`Sem internet · ${n} a enviar`):(on?'Salvo na nuvem':'Sem internet · salvo no aparelho'))}
function saveCache(){if(!session)return;try{localStorage.setItem(cacheKey(session.user.id),JSON.stringify({state,synced:{products:[...synced.products],sales:[...synced.sales],rentals:[...synced.rentals]}}))}catch(e){toast('Sem espaço para guardar no aparelho.')}}
function loadCache(id){try{const c=JSON.parse(localStorage.getItem(cacheKey(id))||'null');if(c&&c.state&&Array.isArray(c.state.products)&&Array.isArray(c.state.sales)&&c.synced){state=c.state;synced={products:new Map(c.synced.products),sales:new Map(c.synced.sales),rentals:new Map(c.synced.rentals||[])};return true}}catch(e){}return false}
function lastUser(){try{return JSON.parse(localStorage.getItem(LAST_KEY)||'null')}catch(e){return null}}
function persist(){if(!session)return;saveCache();status();clearTimeout(syncTimer);syncTimer=setTimeout(syncNow,400)}
async function syncTable(table,list,map){const d=diffOf(list,map),now=new Date().toISOString();const up=d.up.map(x=>({id:x.id,user_id:session.user.id,data:x,updated_at:now}));for(let i=0;i<up.length;i+=200){const r=await sb.from(table).upsert(up.slice(i,i+200));if(r.error)throw r.error}if(d.del.length){const r=await sb.from(table).delete().in('id',d.del);if(r.error)throw r.error}return d.cur}
async function syncNow(){if(!session||!sb||offlineMode)return false;if(!navigator.onLine){status();return false}if(syncing){again=true;return false}syncing=true;let ok=true;try{const p=await syncTable('vf_products',state.products,synced.products);const s=await syncTable('vf_sales',state.sales,synced.sales);const rr=await syncTable('vf_rentals',R(),synced.rentals);synced.products=p;synced.sales=s;synced.rentals=rr;saveCache();status()}catch(e){ok=false;console.error(e);setSync('Falha ao enviar · tentando de novo')}syncing=false;if(again){again=false;syncNow()}return ok}
async function fetchAll(table){let out=[],from=0;for(;;){const r=await sb.from(table).select('id,data').order('id').range(from,from+999);if(r.error)throw r.error;out=out.concat(r.data.map(x=>x.data));if(r.data.length<1000)break;from+=1000}return out}
async function pullRemote(){const products=await fetchAll('vf_products'),sales=await fetchAll('vf_sales'),rentals=await fetchAll('vf_rentals');state={products,sales,rentals};snapshot();saveCache()}
async function refresh(had){if(had&&pending()&&!(await syncNow())){status();return}
try{await pullRemote()}catch(e){console.error(e);setSync(had?'Sem conexão · usando dados do aparelho':'Erro ao carregar');if(!had)toast('Não consegui carregar os dados da nuvem.');render();return}
if(!state.products.length&&!state.sales.length&&legacy&&confirm(`Encontrei dados salvos neste aparelho (${legacy.products.length} produtos e ${legacy.sales.length} contratos). Enviar para a sua conta na nuvem?`)){state={products:legacy.products,sales:legacy.sales};saveCache();if(await syncNow()){try{localStorage.removeItem(KEY)}catch(e){}legacy=null;toast('Dados enviados para a nuvem.')}}
render();status()}
async function onSession(s,off){session=s;offlineMode=!!off;clearTimeout(syncTimer);
if(!s){state={products:[],sales:[]};snapshot();$('#auth').hidden=false;$('#logout').hidden=true;setSync('Entre para começar');render();return}
try{localStorage.setItem(LAST_KEY,JSON.stringify({id:s.user.id,email:s.user.email}))}catch(e){}
$('#auth').hidden=true;$('#logout').hidden=false;
const had=loadCache(s.user.id);if(!had){state={products:[],sales:[]};snapshot()}
render();status();
if(offlineMode||!navigator.onLine){if(!had)setSync('Sem internet · entre uma vez online');return}
await refresh(had)}
function authMsg(t,ok){const m=$('#auth-msg');m.textContent=t;m.classList.toggle('ok',!!ok)}
async function doAuth(signup){if(!sb){authMsg('Não consegui carregar o Supabase. Confira a internet e recarregue a página.');return}const email=$('#auth-email').value.trim(),password=$('#auth-pass').value;if(!email||password.length<8){authMsg('Informe o e-mail e uma senha de pelo menos 8 caracteres.');return}authMsg('Aguarde…',true);
let r;try{r=signup?await sb.auth.signUp({email,password}):await sb.auth.signInWithPassword({email,password})}catch(e){authMsg('Sem conexão. Entre com internet pelo menos uma vez.');return}
if(r.error){authMsg(r.error.message);return}
if(r.data.session){$('#auth-pass').value='';authMsg('');await onSession(r.data.session)}
else authMsg('Conta criada. Abra o e-mail de confirmação e depois volte aqui para entrar.',true)}
async function boot(){if('serviceWorker' in navigator)navigator.serviceWorker.register('sw.js').catch(()=>{});const themeButton=$('#theme-toggle');if(themeButton)themeButton.onclick=()=>applyTheme(document.documentElement.dataset.theme==='dark'?'light':'dark');
$('#auth-in').onclick=()=>doAuth(false);$('#auth-up').onclick=()=>doAuth(true);$('#auth-pass').onkeydown=e=>{if(e.key==='Enter')doAuth(false)};
$('#logout').onclick=async()=>{if(!navigator.onLine||offlineMode||!sb){toast('Para sair, conecte-se à internet.');return}await syncNow();if(pending()&&!confirm('Há alterações que ainda não foram enviadas para a nuvem. Sair agora apaga essas alterações deste aparelho. Sair mesmo assim?'))return;const id=session&&session.user.id;const r=await sb.auth.signOut();if(r&&r.error){toast('Não consegui sair. Tente de novo.');return}try{localStorage.removeItem(cacheKey(id));localStorage.removeItem(LAST_KEY)}catch(e){}await onSession(null)};
window.addEventListener('offline',status);
window.addEventListener('online',async()=>{if(offlineMode&&sb){const {data}=await sb.auth.getSession();if(data.session)await onSession(data.session);else await onSession(null);return}if(session)await syncNow();status()});
setInterval(()=>{if(session&&!offlineMode&&navigator.onLine&&pending()&&!syncing)syncNow()},30000);
const last=lastUser(),hasCache=last&&localStorage.getItem(cacheKey(last.id));
if(!sb){if(hasCache){await onSession({user:last},true);return}$('#auth').hidden=false;authMsg('Sem internet. Entre uma vez com internet para usar o app off-line.');return}
let got={data:{session:null}};try{got=await sb.auth.getSession()}catch(e){got={data:{session:null},error:e}}
if(got.data.session){await onSession(got.data.session);return}
if(hasCache&&(!navigator.onLine||(got.error&&/fetch|network/i.test(got.error.message||'')))){await onSession({user:last},true);return}
await onSession(null)}
function newId(){return (globalThis.crypto&&crypto.randomUUID)?crypto.randomUUID():`vf-${Date.now()}-${Math.random().toString(36).slice(2)}`;}
function toast(msg){const el=document.querySelector('#toast');el.textContent=msg;el.classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.add('hidden'),2600)}
function setPage(p,id=null){if(page==='products'&&p!=='products')editingProductId=null;page=p;receiptId=id;document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===p||((p==='new-sale'||p==='edit-sale'||p==='receipt')&&b.dataset.page==='sales')||((p==='new-rental'||p==='edit-rental'||p==='rental')&&b.dataset.page==='rentals')));render()}
function setNav(){document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>setPage(b.dataset.page));}
function statusSale(s){if(s.installments.every(i=>i.paid))return 'Quitado';if(s.installments.some(i=>!i.paid&&i.due<todayISO()))return 'Atrasado';return 'Em dia'}
function calc(principal,n,monthly){principal=Math.round((Number(principal)||0)*100)/100;n=Math.max(1,parseInt(n)||1);const rate=(Number(monthly)||0)/100;const total=Math.round(principal*(1+rate*n)*100)/100;const installment=Math.round(total/n*100)/100;const amounts=Array(n).fill(installment);if(n>1)amounts[n-1]=Math.round((total-installment*(n-1))*100)/100;const interest=Math.round((total-principal)*100)/100;return {installment,total,interest,amounts};}
function installmentLabel(amounts){if(!amounts||!amounts.length)return '—';const first=amounts[0],last=amounts[amounts.length-1];if(amounts.length>1&&Math.abs(last-first)>=0.01)return `${amounts.length-1}x de ${money(first)} + última de ${money(last)}`;return `${amounts.length}x de ${money(first)}`}
function installmentSummary(s){return installmentLabel((s.installments||[]).map(i=>i.amount))}
function defaultDue(){return addMonth(todayISO(),1)}
function render(){setNav();const root=document.querySelector('#view');if(page==='home')root.innerHTML=homeHTML();else if(page==='products')root.innerHTML=productsHTML();else if(page==='new-sale')root.innerHTML=saleFormHTML();else if(page==='edit-sale')root.innerHTML=saleFormHTML(receiptId);else if(page==='sales')root.innerHTML=salesHTML();else if(page==='receipt')root.innerHTML=receiptHTML(receiptId);else if(page==='rentals')root.innerHTML=rentalsHTML();else if(page==='new-rental')root.innerHTML=rentalFormHTML();else if(page==='edit-rental')root.innerHTML=rentalFormHTML(receiptId);else if(page==='rental')root.innerHTML=rentalReceiptHTML(receiptId);bindPage();bindRental()}
function homeHTML(){const active=state.sales.length;const overdue=state.sales.filter(s=>statusSale(s)==='Atrasado').length;const outstanding=state.sales.reduce((sum,s)=>sum+s.installments.filter(i=>!i.paid).reduce((a,i)=>a+i.amount,0),0);const stock=state.products.reduce((a,p)=>a+p.stock,0);const recent=[...state.sales].slice(-5).reverse();return `<div class="pagehead"><div><h1>Resumo da loja</h1><p>Vendas parceladas e produtos em estoque</p></div><button class="btn" data-go="new-sale">＋ Nova venda</button></div>
<div class="grid stats"><div class="card"><div class="stat-label">Contratos</div><div class="stat-value">${active}</div><div class="stat-sub">vendas cadastradas</div></div><div class="card"><div class="stat-label">A receber</div><div class="stat-value">${money(outstanding)}</div><div class="stat-sub">parcelas ainda não pagas</div></div><div class="card"><div class="stat-label">Atrasados</div><div class="stat-value">${overdue}</div><div class="stat-sub">contratos com vencimento passado</div></div><div class="card"><div class="stat-label">Unidades em estoque</div><div class="stat-value">${stock}</div><div class="stat-sub">celulares e acessórios</div></div></div>
<div class="grid columns"><section class="card"><h2 class="section-title">Vendas recentes</h2>${recent.length?recent.map(s=>`<div class="row"><div class="recent-person"><span class="avatar">${esc(initials(s.customer))}</span><div><div class="row-title">${esc(s.customer)} • ${esc(s.itemName)}</div><div class="muted">${installmentSummary(s)} · ${esc(s.whatsapp)}</div></div></div><div class="recent-right"><strong class="amount">${money(s.total)}</strong><br><span class="badge ${statusSale(s)==='Atrasado'?'red':statusSale(s)==='Quitado'?'green':''}">${statusSale(s)}</span><br><button class="btn small secondary" data-receipt="${s.id}" style="margin-top:7px">Ver recibo</button></div></div>`).join(''):'<div class="empty">Ainda não há vendas. Cadastre produtos e depois lance sua primeira venda.</div>'}</section>
<section class="card"><h2 class="section-title">Atalhos</h2><div class="actions quick-actions"><button class="btn" data-go="new-sale">Nova venda</button><button class="btn secondary" data-go="products">Cadastrar produto</button><button class="btn ghost" data-export>Baixar cópia dos dados</button></div><div class="block-note"><strong>Bloqueio remoto não incluído.</strong> Requer integração específica e compatibilidade confirmada para cada modelo. Esta versão não bloqueia aparelhos.</div><p class="help">A cópia salva um arquivo JSON com seus dados. Guarde-o em local seguro.</p></section></div>`}
function productsHTML(){return `<div class="pagehead"><div><h1>Produtos e estoque</h1><p>Cadastre e gerencie os produtos do seu estoque de forma rápida e organizada.</p></div></div><div class="grid columns"><section class="card"><h2 id="product-form-title" class="section-title">Novo produto</h2><form id="product-form" class="formgrid"><div class="field full"><label>Produto ou modelo</label><input name="name" required maxlength="70" placeholder="Ex.: Película 3D, capinha, iPhone 13"></div><div class="field"><label>Categoria</label><select name="category"><option>Celular</option><option>Película</option><option>Capinha</option><option>Carregador</option><option>Acessório</option><option>Outro</option></select></div><div class="field"><label>Quantidade inicial</label><input name="stock" type="number" min="0" step="1" value="1" required></div><div class="field"><label>Custo de compra por unidade (R$)</label><input name="cost" type="number" min="0" step="0.01" required placeholder="0,00"></div><div class="field"><label>Preço de venda por unidade (R$)</label><input name="price" type="number" min="0.01" step="0.01" required placeholder="0,00"></div><div class="field full"><div class="actions"><button id="product-submit" class="btn" type="submit">＋ Salvar produto</button><button id="product-cancel" class="btn ghost hidden" type="button">Cancelar edição</button></div></div></form></section><section class="card"><h2 class="section-title">Resumo do estoque</h2><div id="stock-summary"></div></section></div><section class="card" style="margin-top:16px"><div class="stock-toolbar"><h2>Estoque atual</h2><div class="actions"><input id="product-search" type="search" placeholder="Buscar produto..." aria-label="Buscar produto"><button type="button" class="btn ghost" data-export-products>Exportar CSV</button><button type="button" class="btn secondary" data-export-products-pdf>Exportar PDF</button></div></div><div id="duplicate-alert"></div><div id="product-table"></div></section>`}
function saleFormHTML(editId=null){const old=editId?state.sales.find(s=>s.id===editId):null;const available=p=>p.stock+(old&&p.id===old.productId?old.quantity:0);const products=state.products.filter(p=>available(p)>0);const options=products.map(p=>`<option value="${p.id}" ${old&&old.productId===p.id?'selected':''}>${esc(p.name)} — ${available(p)} em estoque — venda ${money(p.price)}</option>`).join('');const hasProducts=products.length>0;const next=old?old.firstDue:defaultDue();const title=old?'Editar venda':'Nova venda';return `<div class="pagehead"><div><h1>${title}</h1><p>${old?'Altere os dados da venda e recalcule as parcelas. Só é permitido antes de marcar pagamentos.':'Defina a taxa de juros para este contrato, se quiser cobrar.'}</p></div></div>${hasProducts?`<section class="card"><form id="sale-form"><div class="formgrid"><div class="field"><label>Nome do cliente</label><input name="customer" value="${esc(old?.customer||'')}" maxlength="70" required placeholder="Nome completo"></div><div class="field"><label>WhatsApp do cliente</label><input name="whatsapp" value="${esc(old?.whatsapp||'')}" type="tel" maxlength="20" required placeholder="DDD + número"></div><div class="field full"><label>Produto vendido</label><select name="productId" required><option value="">Escolha um produto do estoque</option>${options}</select></div><div class="field"><label>Quantidade</label><input name="quantity" type="number" min="1" max="${old?available(state.products.find(p=>p.id===old.productId)||{stock:0,id:''}):''}" step="1" value="${old?.quantity||1}" required></div><div class="field"><label>Preço de venda por unidade (R$)</label><input name="unitPrice" type="number" min="0.01" step="0.01" value="${old?.unitPrice||''}" required></div><div class="field"><label>Número de parcelas</label><input name="n" type="number" min="1" max="48" step="1" value="${old?.n||1}" required></div><div class="field"><label>Juros ao mês (%) — definido nesta venda</label><input name="rate" type="number" min="0" max="100" step="0.01" value="${old?old.rate:''}" placeholder="0,00"></div><div class="field"><label>Primeiro vencimento</label><input name="firstDue" type="date" value="${esc(next)}" required></div></div><div id="sale-preview" class="preview"></div><div class="actions" style="margin-top:14px"><button class="btn" type="submit">${old?'Salvar alterações':'Salvar venda e gerar recibo'}</button>${old?'<button class="btn ghost" type="button" data-cancel-sale-edit>Cancelar</button>':'<button class="btn ghost" type="button" data-go="products">Voltar aos produtos</button>'}</div></form><div class="block-note">Juros simples: a taxa mensal é aplicada ao valor original a cada mês, sem juros sobre juros. Se houver diferença de centavos, a última parcela é ajustada. O bloqueio remoto não está disponível nesta versão.</div></section>`:'<section class="card"><div class="empty">Cadastre primeiro o celular ou acessório em Produtos, informando custo, preço e estoque.<br><br><button class="btn" data-go="products">Cadastrar produto</button></div></section>'}`}
function salesHTML(){const list=[...state.sales].reverse();return `<div class="pagehead"><div><h1>Contratos</h1><p>Consulte parcelas, recibos e situação de pagamento.</p></div><button class="btn" data-go="new-sale">＋ Nova venda</button></div><div class="sales-toolbar"><strong>Contratos de venda parcelada · <span id="sales-count">${list.length}</span> registros</strong><input id="sales-search" type="search" placeholder="Buscar por cliente, celular ou WhatsApp..." aria-label="Buscar contrato"></div><section class="card">${list.length?`<div class="contractlist">${list.map(s=>{const st=statusSale(s),searchable=[s.customer,s.itemName,s.whatsapp].join(' ').toLocaleLowerCase('pt-BR');return `<div class="row contract sales-contract" data-search="${esc(searchable)}"><span class="avatar">${esc(initials(s.customer))}</span><div class="contract-info"><strong>${esc(s.customer)} — ${esc(s.itemName)}</strong><small>${installmentSummary(s)} · ${esc(s.whatsapp)} · início ${fmtDate(s.firstDue)}</small></div><div class="contract-actions"><span class="badge ${st==='Atrasado'?'red':st==='Quitado'?'green':''}">${st}</span><button class="btn small ghost" data-edit-sale="${s.id}">Editar venda</button><button class="btn small danger" data-delete-sale="${s.id}">Excluir</button><button class="btn small secondary" data-receipt="${s.id}">Recibo / parcelas</button></div></div>`}).join('')}</div>`:'<div class="empty">Nenhum contrato registrado ainda.</div>'}</section>`}
function receiptHTML(id){const s=state.sales.find(x=>x.id===id);if(!s){page='sales';return salesHTML()}const status=statusSale(s);return `<div class="pagehead no-print"><div><h1>Recibo e parcelas</h1><p>Contrato da venda registrada</p></div><div class="actions"><button class="btn ghost" data-go="sales">Voltar</button><button class="btn secondary" data-edit-sale="${s.id}" ${s.installments.some(it=>it.paid)?'disabled title="Venda com pagamentos registrados não pode ser alterada."':''}>Editar venda</button><button class="btn danger" data-delete-sale="${s.id}">Excluir contrato</button><button class="btn" data-print>Imprimir / salvar PDF</button><button class="btn secondary" data-share="${s.id}">Compartilhar recibo</button></div></div><section class="card receipt"><div class="receipthead"><h2>RECIBO DE VENDA PARCELADA</h2><div class="muted">VendaFácil • comprovante gerado em ${fmtDate(s.createdAt)}</div></div><div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr));gap:10px"><div><div class="muted">CLIENTE</div><strong>${esc(s.customer)}</strong><div class="muted" style="margin-top:4px">WhatsApp: ${esc(s.whatsapp)}</div></div><div><div class="muted">PRODUTO</div><strong>${esc(s.itemName)}</strong><div class="muted" style="margin-top:4px">Quantidade: ${s.quantity}</div></div></div><div class="receipt-total"><div><strong>Valor dos produtos: ${money(s.principal)}</strong></div><div class="muted" style="margin-top:6px">Juros simples sobre valor original: ${Number(s.rate).toFixed(2).replace('.',',')}% ao mês · juros totais ${money(s.interest)}</div><div style="margin-top:6px"><strong>Total a pagar: ${money(s.total)} · ${s.n} parcelas</strong></div></div><table class="installments"><thead><tr><th>Parcela</th><th>Vencimento</th><th>Valor</th><th>Status</th><th class="no-print">Ação</th></tr></thead><tbody>${s.installments.map((it,idx)=>`<tr><td>${String(idx+1).padStart(2,'0')} / ${s.n}</td><td>${fmtDate(it.due)}</td><td>${money(it.amount)}</td><td class="${it.paid