function exportBackup(){const blob=new Blob([JSON.stringify({app:'VendaFácil',version:1,exportedAt:new Date().toISOString(),...state},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='backup-vendafacil.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1500);toast('Cópia de segurança baixada.')}

function R(){if(!Array.isArray(state.rentals))state.rentals=[];return state.rentals}
const pct=(n)=>Number(n).toFixed(2).replace('.',',')+'%';
function rentDue(r,i){return addMonth(r.firstDue,i)}
function rentStatus(r){if(r.endedAt)return 'Encerrado';if(r.term>0&&r.payments.length>=r.term)return 'Concluído';return rentDue(r,r.payments.length)<todayISO()?'Atrasado':'Em dia'}
function rentActive(r){const st=rentStatus(r);return st==='Em dia'||st==='Atrasado'}
function rentOverdue(r){let k=r.payments.length,n=0;while(rentDue(r,k)<todayISO()&&n<600&&(!(r.term>0)||k<r.term)){k++;n++}return n}
function rentBadge(st){return st==='Atrasado'?'red':(st==='Em dia'||st==='Concluído')?'green':''}
function rentalsHTML(){const all=[...R()].reverse().sort((a,b)=>{const lateA=rentStatus(a)==='Atrasado',lateB=rentStatus(b)==='Atrasado';if(lateA!==lateB)return lateA?-1:1;if(lateA)return rentDue(a,a.payments.length).localeCompare(rentDue(b,b.payments.length));return 0}),act=all.filter(rentActive),month=todayISO().slice(0,7);const deviceValueTotal=act.reduce((a,r)=>a+(Number(r.deviceValue)||0),0);const expected=act.reduce((a,r)=>a+r.monthly,0);const received=R().reduce((a,r)=>a+r.payments.filter(x=>String(x.paidAt).slice(0,7)===month).reduce((b,x)=>b+x.amount,0),0);const late=act.reduce((a,r)=>a+r.monthly*rentOverdue(r),0);
return `<div class="pagehead"><div><h1>Aluguéis</h1><p>O cliente paga uma porcentagem do valor do aparelho por mês.</p></div><button class="btn" data-go="new-rental">＋ Novo aluguel</button></div>
<div class="grid stats"><div class="card"><div class="stat-label">Valor dos aparelhos alugados</div><div class="stat-value">${money(deviceValueTotal)}</div><div class="stat-sub">${act.length} aparelho(s) em andamento</div></div><div class="card"><div class="stat-label">Previsto por mês</div><div class="stat-value">${money(expected)}</div><div class="stat-sub">soma das mensalidades</div></div><div class="card"><div class="stat-label">Recebido no mês</div><div class="stat-value">${money(received)}</div><div class="stat-sub">pagamentos registrados</div></div><div class="card"><div class="stat-label">Em atraso</div><div class="stat-value">${money(late)}</div><div class="stat-sub">mensalidades vencidas</div></div></div>
<section class="card" style="margin-top:14px">${all.length?`<div class="contractlist">${all.map(r=>{const st=rentStatus(r),on=rentActive(r);return `<div class="row contract"><div class="contract-info"><strong>${esc(r.customer)} — ${esc(r.itemName)}</strong><small>${pct(r.rate)} ao mês · ${money(r.monthly)}/mês · ${on?'próximo vencimento '+fmtDate(rentDue(r,r.payments.length)):st}${st==='Atrasado'?' · '+rentOverdue(r)+' mês(es) em atraso':''}</small></div><div class="contract-actions"><span class="badge ${rentBadge(st)}">${st}</span>${on?`<button class="btn small" data-rent-pay="${r.id}">Registrar pagamento</button>`:''}${!r.endedAt&&!r.payments.length?`<button class="btn small ghost" data-rent-edit="${r.id}">Editar aluguel</button>`:''}<button class="btn small secondary" data-rental="${r.id}">Recibo / pagamentos</button></div></div>`}).join('')}</div>`:'<div class="empty">Nenhum aluguel registrado ainda.</div>'}</section>`}
function rentalFormHTML(editId=null){const old=editId?R().find(r=>r.id===editId):null;const available=p=>p.stock+(old&&p.id===old.productId?1:0);const products=state.products.filter(p=>available(p)>0);const opts=products.map(p=>`<option value="${p.id}" ${old&&old.productId===p.id?'selected':''}>${esc(p.name)} — ${available(p)} em estoque</option>`).join('');const title=old?'Editar aluguel':'Novo aluguel';if(!products.length)return `<div class="pagehead"><div><h1>${title}</h1><p>Escolha um aparelho do estoque para alugar.</p></div></div><section class="card"><div class="empty">Não há aparelho disponível para este aluguel.</div><div class="actions"><button class="btn" data-go="products">Ver produtos</button></div></section>`;return `<div class="pagehead"><div><h1>${title}</h1><p>${old?'Altere os dados antes de registrar pagamentos.':'A mensalidade é a porcentagem informada sobre o valor do aparelho.'}</p></div></div><section class="card"><form id="rental-form"><div class="formgrid"><div class="field"><label>Nome do cliente</label><input name="customer" value="${esc(old?.customer||'')}" maxlength="70" required placeholder="Nome completo"></div><div class="field"><label>WhatsApp do cliente</label><input name="whatsapp" value="${esc(old?.whatsapp||'')}" type="tel" maxlength="20" required placeholder="DDD + número"></div><div class="field full"><label>Aparelho (do estoque)</label><select name="productId" required><option value="">Escolha um produto do estoque</option>${opts}</select></div><div class="field"><label>Valor do aparelho (R$)</label><input name="deviceValue" type="number" min="0.01" step="0.01" value="${old?old.deviceValue:''}" required></div><div class="field"><label>Percentual ao mês (%)</label><input name="rate" type="number" min="0.01" max="100" step="0.01" value="${old?old.rate:10}" required></div><div class="field"><label>Primeiro vencimento</label><input name="firstDue" type="date" value="${old?old.firstDue:defaultDue()}" required></div><div class="field"><label>Prazo em meses (0 = sem prazo)</label><input name="term" type="number" min="0" max="120" step="1" value="${old?old.term:0}" required></div></div><div class="block-note" id="rental-preview"></div><div class="actions" style="margin-top:12px"><button class="btn" type="submit">${old?'Salvar alterações':'Salvar aluguel'}</button>${old?'<button class="btn ghost" type="button" data-rent-cancel-edit>Cancelar</button>':'<button class="btn ghost" type="button" data-go="rentals">Cancelar</button>'}</div></form></section>`}
function previewRental(){const f=$('#rental-form');if(!f)return;const v=Number(f.deviceValue.value),rt=Number(f.rate.value),t=parseInt(f.term.value)||0,box=$('#rental-preview');if(!(v>0&&rt>0)){box.textContent='Informe o valor do aparelho e o percentual para ver a mensalidade.';return}const m=Math.round(v*rt)/100;box.innerHTML=`<strong>Mensalidade: ${money(m)}</strong><br>${money(v)} × ${pct(rt)} por mês${t>0?` · em ${t} meses: ${money(m*t)}`:' · sem prazo definido'}<br><small>O aparelho sai do estoque enquanto estiver alugado e volta quando o aluguel for encerrado.</small>`}
function addRental(e){e.preventDefault();const f=e.currentTarget;const p=state.products.find(x=>x.id===f.productId.value);if(!p||p.stock<1){toast('Escolha um aparelho com estoque.');return}const customer=f.customer.value.trim(),whatsapp=f.whatsapp.value.trim(),dv=Number(f.deviceValue.value),rate=Number(f.rate.value),firstDue=f.firstDue.value,term=parseInt(f.term.value)||0;if(!customer||!whatsapp||!firstDue||!(dv>0)||!(rate>0)||rate>100||term<0||term>120){toast('Confira os dados do aluguel.');return}const monthly=Math.round(dv*rate)/100;if(!confirm(`Salvar aluguel para ${customer}? Mensalidade ${money(monthly)} (${pct(rate)} de ${money(dv)}).`))return;p.stock-=1;const r={id:newId(),customer,whatsapp,productId:p.id,itemName:p.name,category:p.category,deviceValue:dv,rate,monthly,firstDue,term,payments:[],createdAt:todayISO()};R().push(r);persist();setPage('rental',r.id);toast('Aluguel salvo.')}
function beginEditRental(id){const r=R().find(x=>x.id===id);if(!r)return;if(r.endedAt||r.payments.length){toast('Só é possível editar aluguel ativo antes de registrar pagamentos.');return}setPage('edit-rental',id)}
function updateRental(e){e.preventDefault();const old=R().find(x=>x.id===receiptId);if(!old){toast('Aluguel não encontrado.');setPage('rentals');return}if(old.endedAt||old.payments.length){toast('Este aluguel já foi encerrado ou tem pagamento registrado.');setPage('rental',old.id);return}const f=e.currentTarget,p=state.products.find(x=>x.id===f.productId.value),customer=f.customer.value.trim(),whatsapp=f.whatsapp.value.trim(),dv=Number(f.deviceValue.value),rate=Number(f.rate.value),firstDue=f.firstDue.value,term=parseInt(f.term.value);if(!p){toast('Escolha um aparelho do estoque.');return}const available=p.stock+(p.id===old.productId?1:0);if(available<1){toast('Não há estoque disponível para esse aparelho.');return}if(!customer||!whatsapp||!firstDue||!(dv>0)||!(rate>0)||rate>100||!Number.isInteger(term)||term<0||term>120){toast('Confira os dados do aluguel.');return}const monthly=Math.round(dv*rate)/100;if(!confirm(`Salvar alterações do aluguel de ${customer}? Nova mensalidade: ${money(monthly)} (${pct(rate)} de ${money(dv)}).`))return;const previous=state.products.find(x=>x.id===old.productId);if(previous)previous.stock+=1;p.stock-=1;Object.assign(old,{customer,whatsapp,productId:p.id,itemName:p.name,category:p.category,deviceValue:dv,rate,monthly,firstDue,term,updatedAt:todayISO()});persist();setPage('rental',old.id);toast('Aluguel atualizado.')}
function payRental(id){const r=R().find(x=>x.id===id);if(!r||!rentActive(r))return;const i=r.payments.length;if(!confirm(`Registrar o pagamento da mensalidade ${i+1} (${money(r.monthly)}, vencimento ${fmtDate(rentDue(r,i))})? Confirme que recebeu.`))return;r.payments.push({i,amount:r.monthly,paidAt:todayISO()});persist();render();toast('Pagamento registrado.')}
function undoRental(id){const r=R().find(x=>x.id===id);if(!r||r.endedAt||!r.payments.length)return;if(!confirm('Desfazer o último pagamento registrado?'))return;r.payments.pop();persist();render();toast('Pagamento desfeito.')}
function endRental(id){const r=R().find(x=>x.id===id);if(!r||r.endedAt)return;if(!confirm(`Encerrar o aluguel de ${r.customer}? O aparelho volta ao estoque.`))return;const p=state.products.find(x=>x.id===r.productId);if(p)p.stock+=1;r.endedAt=todayISO();persist();render();toast('Aluguel encerrado.')}
function deleteRental(id){const r=R().find(x=>x.id===id);if(!r)return;if(r.payments.length){toast('Há pagamentos registrados. Encerre o aluguel em vez de excluir.');return}if(!confirm(`Excluir o aluguel de ${r.customer}?${r.endedAt?'':' O aparelho volta ao estoque.'}`))return;if(!r.endedAt){const p=state.products.find(x=>x.id===r.productId);if(p)p.stock+=1}state.rentals=R().filter(x=>x.id!==id);persist();setPage('rentals');toast('Aluguel excluído.')}
function rentalReceiptHTML(id){const r=R().find(x=>x.id===id);if(!r){page='rentals';return rentalsHTML()}const st=rentStatus(r),on=rentActive(r),rows=r.term>0?r.term:r.payments.length+(on?3:0);let body='';
for(let i=0;i<rows;i++){const pay=r.payments[i],due=rentDue(r,i),late=!pay&&due<todayISO();const action=pay?(i===r.payments.length-1&&!r.endedAt?`<button class="btn small ghost" data-rent-undo="${r.id}">Desfazer</button>`:''):(i===r.payments.length&&on?`<button class="btn small secondary" data-rent-pay="${r.id}">Marcar paga</button>`:'');body+=`<tr><td>${String(i+1).padStart(2,'0')}${r.term>0?' / '+r.term:''}</td><td>${fmtDate(due)}</td><td>${money(r.monthly)}</td><td class="${pay?'paid':late?'late':''}">${pay?'Paga em '+fmtDate(pay.paidAt):late?'Atrasada':'Pendente'}</td><td class="no-print">${action}</td></tr>`}
return `<div class="pagehead no-print"><div><h1>Recibo e pagamentos</h1><p>Aluguel registrado</p></div><div class="actions"><button class="btn ghost" data-go="rentals">Voltar</button>${!r.endedAt&&!r.payments.length?`<button class="btn secondary" data-rent-edit="${r.id}">Editar aluguel</button>`:''}<button class="btn" data-print>Imprimir / salvar PDF</button><button class="btn secondary" data-rent-share="${r.id}">Compartilhar recibo</button>${r.endedAt?'':`<button class="btn secondary" data-rent-end="${r.id}">Encerrar aluguel</button>`}<button class="btn danger" data-rent-del="${r.id}">Excluir</button></div></div><section class="card receipt"><div class="receipthead"><h2>RECIBO DE ALUGUEL</h2><div class="muted">VendaFácil • contrato criado em ${fmtDate(r.createdAt)}</div></div><div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr));gap:10px"><div><div class="muted">CLIENTE</div><strong>${esc(r.customer)}</strong><div class="muted" style="margin-top:4px">WhatsApp: ${esc(r.whatsapp)}</div></div><div><div class="muted">APARELHO</div><strong>${esc(r.itemName)}</strong><div class="muted" style="margin-top:4px">Valor do aparelho: ${money(r.deviceValue)}</div></div></div><div class="receipt-total"><div><strong>Mensalidade: ${money(r.monthly)}</strong></div><div class="muted" style="margin-top:6px">${pct(r.rate)} do valor do aparelho por mês · ${r.term>0?'prazo de '+r.term+' meses':'sem prazo definido'}</div><div style="margin-top:6px"><strong>Situação: ${st}${r.endedAt?' em '+fmtDate(r.endedAt):''}</strong></div></div><table class="installments"><thead><tr><th>Mês</th><th>Vencimento</th><th>Valor</th><th>Status</th><th class="no-print">Ação</th></tr></thead><tbody>${body}</tbody></table><div class="footer-note">As datas seguem mensalmente a partir do primeiro vencimento. Guarde este comprovante. Confirme o recebimento antes de registrar um pagamento.</div></section>`}
function shareRental(id){const r=R().find(x=>x.id===id);if(!r)return;const text=`RECIBO DE ALUGUEL\nCliente: ${r.customer}\nAparelho: ${r.itemName}\nValor do aparelho: ${money(r.deviceValue)}\nPercentual: ${pct(r.rate)} ao mês\nMensalidade: ${money(r.monthly)}\n${r.term>0?'Prazo: '+r.term+' meses':'Sem prazo definido'}\n\nPagamentos:\n${r.payments.length?r.payments.map(x=>`Mês ${String(x.i+1).padStart(2,'0')}: ${money(x.amount)} — pago em ${fmtDate(x.paidAt)}`).join('\n'):'Nenhum pagamento registrado ainda.'}\nPróximo vencimento: ${rentActive(r)?fmtDate(rentDue(r,r.payments.length)):'—'}\n\nComprovante gerado pelo controle da loja.`;if(navigator.share){navigator.share({title:'Recibo de aluguel',text}).catch(()=>{})}else if(navigator.clipboard){navigator.clipboard.writeText(text).then(()=>toast('Recibo copiado. Cole no WhatsApp.')).catch(()=>toast('Não foi possível copiar o recibo.'))}else{window.prompt('Copie o recibo:',text)}}
function bindRental(){const q=(sel,fn)=>document.querySelectorAll(sel).forEach(fn);q('[data-rental]',b=>b.onclick=()=>setPage('rental',b.dataset.rental));q('[data-rent-edit]',b=>b.onclick=()=>beginEditRental(b.dataset.rentEdit));q('[data-rent-pay]',b=>b.onclick=()=>payRental(b.dataset.rentPay));q('[data-rent-undo]',b=>b.onclick=()=>undoRental(b.dataset.rentUndo));q('[data-rent-end]',b=>b.onclick=()=>endRental(b.dataset.rentEnd));q('[data-rent-del]',b=>b.onclick=()=>deleteRental(b.dataset.rentDel));q('[data-rent-share]',b=>b.onclick=()=>shareRental(b.dataset.rentShare));const cancel=$('[data-rent-cancel-edit]');if(cancel)cancel.onclick=()=>setPage('rental',receiptId);
const f=$('#rental-form');if(f){f.onsubmit=page==='edit-rental'?updateRental:addRental;f.oninput=previewRental;f.productId.onchange=()=>{const p=state.products.find(x=>x.id===f.productId.value);if(p&&p.price>0)f.deviceValue.value=p.price;previewRental()};previewRental()}}
render();boot();
})();
</script>
<div id="pdf-stock-report"></div>
</body>
</html>
