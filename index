function deleteSale(id){const s=state.sales.find(x=>x.id===id);if(!s)return;if(s.installments.some(it=>it.paid)){toast('Não posso excluir: há parcelas marcadas como pagas. Preserve o histórico do contrato.');return}const product=state.products.find(p=>p.id===s.productId);const restock=product?` As ${s.quantity} unidade(s) de “${product.name}” voltarão ao estoque.`:' O produto não existe mais no cadastro, então o estoque não será reposto.';if(!confirm(`Excluir o contrato de ${s.customer}? Esta ação não pode ser desfeita.${restock}`))return;if(product)product.stock+=s.quantity;state.sales=state.sales.filter(x=>x.id!==id);persist();setPage('sales');toast('Contrato excluído.')}
function beginEditSale(id){const s=state.sales.find(x=>x.id===id);if(!s)return;if(s.installments.some(it=>it.paid)){toast('Esta venda tem parcelas pagas. A edição está bloqueada para preservar o histórico.');return}setPage('edit-sale',id)}
function updateSale(e){e.preventDefault();const f=e.currentTarget;const old=state.sales.find(s=>s.id===receiptId);if(!old){toast('Venda não encontrada.');setPage('sales');return}if(old.installments.some(it=>it.paid)){toast('Esta venda tem parcelas pagas e não pode ser alterada.');setPage('receipt',old.id);return}const get=n=>f.elements.namedItem(n).value;const p=state.products.find(x=>x.id===get('productId'));const q=parseInt(get('quantity')),unit=Number(get('unitPrice')),n=parseInt(get('n')),rate=Number(get('rate'))||0,firstDue=get('firstDue'),customer=get('customer').trim(),whatsapp=get('whatsapp').trim();if(!p){toast('Escolha um produto cadastrado.');return}const available=p.stock+(p.id===old.productId?old.quantity:0);if(!Number.isInteger(q)||q<1||q>available){toast(`Estoque insuficiente. Disponível: ${available}.`);return}if(!customer||!whatsapp||!firstDue||!Number.isFinite(unit)||unit<=0||!Number.isInteger(n)||n<1||n>48||rate<0||rate>100){toast('Confira os dados da venda.');return}const principal=Math.round(q*unit*100)/100,c=calc(principal,n,rate);if(!confirm(`Salvar alterações? Novo total: ${money(c.total)}. Pagamentos: ${installmentLabel(c.amounts)}.`))return;const previous=state.products.find(x=>x.id===old.productId);if(previous)previous.stock+=old.quantity;p.stock-=q;Object.assign(old,{customer,whatsapp,itemName:p.name,category:p.category,productId:p.id,quantity:q,unitPrice:unit,principal,rate,n,firstDue,total:c.total,interest:c.interest,installments:Array.from({length:n},(_,i)=>({due:addMonth(firstDue,i),amount:c.amounts[i],paid:false})),updatedAt:todayISO()});persist();setPage('receipt',old.id);toast('Venda atualizada e parcelas recalculadas.')}
function previewSale(){const f=document.querySelector('#sale-form');if(!f)return;const get=n=>f.elements.namedItem(n).value;const p=state.products.find(x=>x.id===get('productId'));const old=page==='edit-sale'?state.sales.find(s=>s.id===receiptId):null;const available=p?p.stock+(old&&p.id===old.productId?old.quantity:0):0;const q=Math.max(1,parseInt(get('quantity'))||1),unit=Number(get('unitPrice'))||0,n=Math.max(1,parseInt(get('n'))||1),rate=Number(get('rate'))||0;const principal=q*unit;const c=calc(principal,n,rate);const quantityInput=f.elements.namedItem('quantity');if(p)quantityInput.max=available;const el=document.querySelector('#sale-preview');el.innerHTML=`<strong>${installmentLabel(c.amounts)}</strong><div class="smallline">Valor dos produtos: ${money(principal)} · Juros simples estimados: ${money(c.interest)}</div><div class="smallline"><b>Total do contrato: ${money(c.total)}</b>${rate?` · taxa ${rate.toFixed(2).replace('.',',')}% a.m., sobre o valor original`:' · sem juros'}</div>${p?`<div class="smallline">Estoque após venda: ${Math.max(0,available-q)} un.</div>`:''}`}
function addSale(e){e.preventDefault();const f=e.currentTarget;const p=state.products.find(x=>x.id===f.productId.value);if(!p){toast('Escolha um produto cadastrado.');return}const q=parseInt(f.quantity.value);if(!Number.isInteger(q)||q<1||q>p.stock){toast(`Estoque insuficiente. Disponível: ${p.stock}.`);return}const customer=f.customer.value.trim(),whatsapp=f.whatsapp.value.trim(),rate=Number(f.rate.value)||0,n=parseInt(f.n.value),firstDue=f.firstDue.value,unit=Number(f.unitPrice.value);if(!customer||!whatsapp||!firstDue||!Number.isFinite(unit)||unit<=0){toast('Preencha os dados da venda.');return}const principal=Math.round(q*unit*100)/100;const c=calc(principal,n,rate);const installments=Array.from({length:n},(_,i)=>({due:addMonth(firstDue,i),amount:c.amounts[i],paid:false}));const sale={id:newId(),customer,whatsapp,itemName:p.name,category:p.category,productId:p.id,quantity:q,unitPrice:unit,principal,rate,n,firstDue,total:c.total,interest:c.interest,installments,createdAt:todayISO()};if(!confirm(`Salvar venda para ${customer}? Total ${money(c.total)}. Pagamentos: ${installmentLabel(c.amounts)}.`))return;p.stock-=q;state.sales.push(sale);persist();setPage('receipt',sale.id);toast('Venda salva. Recibo pronto.')}
