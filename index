function messageFor(s){return `RECIBO DE VENDA PARCELADA\nCliente: ${s.customer}\nProduto: ${s.itemName} (quantidade: ${s.quantity})\nValor dos produtos: ${money(s.principal)}\nJuros simples sobre valor original: ${Number(s.rate).toFixed(2).replace('.',',')}% ao mês\nTotal: ${money(s.total)} em ${s.n} parcelas\n\n${s.installments.map((it,i)=>`Parcela ${String(i+1).padStart(2,'0')}: ${money(it.amount)} — vence ${fmtDate(it.due)}`).join('\n')}\n\nComprovante gerado pelo controle da loja.`}
